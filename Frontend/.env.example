# Referência do destino da API; não é configuração do SQL Server.
# vite.config.ts lê process.env.VITE_API_TARGET sem carregar explicitamente
# este arquivo para o proxy. Copiar para .env.local não basta.
# No PowerShell, antes de npm run dev:
# $env:VITE_API_TARGET = "http://localhost:5108"
# Reinicie Vite após mudar o destino. Sem a variável, usa a URL abaixo.
# Não inclua senhas, tokens ou strings de conexão.
VITE_API_TARGET=http://localhost:5108
